#!/usr/bin/env ruby

class Deploy
  class << self
    def build
      command = "jekyll build"
      puts "Build Started"
      system(command)
      puts "Build Complete"
    end

    def git_tasks

    end

    def sync
      # NOTE: --delete intentionally omitted — server holds legacy project dirs
      # (projects/*, font-awesome/, etc.) that aren't in this repo. See IMPROVEMENTS.md #2.
      command = "rsync -av ./_site/ blog:/home/zeebee/zacbaston.com/"
      puts "Deploying to Dreamhost"
      system(command)
    end

    def call
      begin
        build
        sync
      rescue Exception => e
        puts "Error: #{e}"
      end
    end
  end
end

Deploy.call